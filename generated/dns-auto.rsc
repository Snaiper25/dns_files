/ip dns static add name="yt3.googleusercontent.com" type=FWD match-subdomain=yes address-list=to-vpn-youtube comment="github:dns-files:youtube"
/ip dns static add name="ytimg.com" type=FWD match-subdomain=yes address-list=to-vpn-youtube comment="github:dns-files:youtube"

